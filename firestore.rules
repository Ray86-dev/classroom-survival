// ============================================================
// Classroom Survival — ranking mundial (Firebase Firestore)
// Pégalo entero en Firebase Console → Firestore Database → Rules → Publish.
// Permite: leer el top a cualquiera; crear SOLO marcas válidas.
// Prohíbe: modificar o borrar nada, y campos fuera de la lista.
// ============================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /scores/{id} {
      // El top es público: cualquiera puede leerlo.
      allow read: if true;

      // Crear puntuación solo si es válida y con estos campos exactos.
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'score', 'dur', 'alumnos', 'win', 'mins', 'con', 'combo', 'date']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 16
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 99999
        && request.resource.data.dur in [5, 10, 15, 25, 50]
        && request.resource.data.alumnos is int
        && request.resource.data.alumnos >= 6
        && request.resource.data.alumnos <= 30
        && request.resource.data.win is bool
        && request.resource.data.mins is number
        && request.resource.data.mins >= 0
        && request.resource.data.mins <= 55
        && request.resource.data.con is number
        && request.resource.data.con >= 0
        && request.resource.data.con <= 100
        && request.resource.data.combo is number
        && request.resource.data.combo >= 0
        && request.resource.data.combo <= 99;

      // Ni editar ni borrar: ni siquiera el propio jugador.
      allow update, delete: if false;
    }

  }
}
